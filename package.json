{
  "name": "business-panel",
  "description": "Displays events in a sleek calendar view, pulling from diverse data sources for seamless integration",
  "version": "4.2.4",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "levitate": "npx @grafana/levitate@latest is-compatible --path src/module.ts --target @grafana/data,@grafana/runtime,@grafana/ui",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "docker compose pull grafana && docker compose up",
    "stop": "docker compose down",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --maxWorkers 4 --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:dev": "npx playwright test --ui",
    "test:e2e:docker": "docker compose --profile playwright up --force-recreate --abort-on-container-exit --exit-code-from playwright",
    "typecheck": "tsc --noEmit",
    "markdownlint": "markdownlint-cli2 AGENTS.md CHANGELOG.md README.md",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "upgrade": "npm upgrade --save"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "^3.8.0",
    "@grafana/tsconfig": "^2.1.0",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.17",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.4",
    "@types/react-big-calendar": "^1.16.2",
    "@types/webpack-env": "^1.18.8",
    "@volkovlabs/eslint-config": "^2.0.0",
    "@volkovlabs/jest-selectors": "^1.5.0",
    "copy-webpack-plugin": "^12.0.2",
    "cspell": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.32.0",
    "eslint-webpack-plugin": "^5.0.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.0.3",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.6.2",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "util": "^0.12.5",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "^11.13.0",
    "@grafana/data": "12.4.3",
    "@grafana/runtime": "12.4.3",
    "@grafana/ui": "12.4.3",
    "dayjs": "^1.11.13",
    "i18next": "^25.3.2",
    "react": "18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "18.3.1",
    "react-i18next": "^15.6.1",
    "tslib": "^2.8.0"
  }
}
